{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pagepad-demo",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "PAD", "class_name": "PadRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PadRelay"] }],
  "observability": { "enabled": true }
}
